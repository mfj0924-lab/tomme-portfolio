---
import '../styles/global.css';
import AmbientDataField from '../components/AmbientDataField.astro';
interface Props { title?: string; description?: string; ambient?: boolean; ambientScope?: string; image?: string; robots?: string; }
const {
  title = 'Tomme｜数据、判断与AI协作',
  description = 'Tomme 的数据分析、经营分析与AI协作实践：作品是判断留下的证据。',
  ambient = false,
  ambientScope = 'home',
  image = '/og-image.png',
  robots = 'index, follow',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const shareImage = new URL(image, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f4f7fb" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tomme｜作品与判断" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tomme的数据分析、经营分析与AI协作个人网站预览" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <title>{title}</title>
  </head>
  <body>
    <!--
      THESIS: 作品记录判断如何进入现实问题，也提供能够复查的过程和证据；拒绝标准作品集卡片墙与纯文学博客。
      OWN-WORLD: 冷白研究台、深蓝文字、钴蓝路径与珊瑚色修正；半透明证据层叠放，但正文和截图保持锐利。
      STORY: 先认识Tomme关心的问题，再沿思想进入项目，在任意节点转向代码、报告与边界。
      FIRST VIEWPORT: 左侧一句本人陈述与双阅读路线，右侧头像和五个项目轨迹；主要行动在陈述下方。
      FORM: 透明证据工作台，排序第4；快速路线与深入路线共享节点。seed 0bb03006。
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    {ambient && <AmbientDataField scope={ambientScope} />}
    <a class="skip-link" href="#main">跳到主要内容</a>
    <aside class="site-rail" aria-label="网站目录">
      <a class="brand" href="/" aria-label="返回Tomme首页">Tomme<span>／作品与判断</span></a>
      <nav aria-label="主要导航">
        <a href="/">首页</a><a href="/#projects">项目</a><a href="/method/">分析方法</a><a href="/ai-collaboration/">AI协作</a><a href="/about/">关于我</a>
      </nav>
      <div class="rail-projects" aria-label="项目快捷入口">
        <span>从作品进入</span>
        <a href="/projects/citibike/">CitiBike</a><a href="/projects/adventureworks/">AdventureWorks</a><a href="/projects/workbench/">可信分析工作台</a><a href="/projects/qingdao-transit/">青岛公交网络</a><a href="/projects/rnd-patent/">研发与专利整合</a>
      </div>
      <div class="rail-actions">
        <a class="resume-link" href="/downloads/Tomme_经营分析商业分析_展示版.pdf" download>下载简历 PDF ↗</a>
        <a href="mailto:1877916299@qq.com">1877916299@qq.com</a>
        <span class="contact-label">微信：ccsjt0924</span>
      </div>
    </aside>
    <header class="mobile-header">
      <a class="brand" href="/">Tomme</a>
      <details><summary>目录</summary><nav><a href="/">首页</a><a href="/#projects">项目</a><a href="/method/">方法</a><a href="/ai-collaboration/">AI协作</a><a href="/about/">关于我</a></nav></details>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <p><strong>Tomme</strong><span>我希望数据帮助人看清事实，也希望AI扩大人的选择。最终判断与现实责任仍然由人承担。</span></p>
      <div><a href="mailto:1877916299@qq.com">邮箱</a><span class="contact-label">微信：ccsjt0924</span><a href="https://github.com/mfj0924-lab">GitHub</a><a href="/downloads/Tomme_经营分析商业分析_展示版.pdf" download>简历PDF</a></div>
    </footer>
    <script>
      const dialog = document.querySelector('#image-dialog');
      document.querySelectorAll('[data-lightbox]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!(dialog instanceof HTMLDialogElement)) return;
          const image = dialog.querySelector('img');
          const caption = dialog.querySelector('figcaption');
          if (image instanceof HTMLImageElement) { image.src = button.getAttribute('data-src') || ''; image.alt = button.getAttribute('data-alt') || ''; }
          if (caption) caption.textContent = button.getAttribute('data-caption') || '';
          dialog.showModal();
        });
      });
      document.querySelectorAll('[data-close-dialog]').forEach((button) => button.addEventListener('click', () => { if (dialog instanceof HTMLDialogElement) dialog.close(); }));
    </script>
  </body>
</html>
