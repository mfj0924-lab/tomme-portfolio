---
import VisualProjectPage from '../../components/VisualProjectPage.astro';
import {portfolioProjects} from '../../data/preview';
export function getStaticPaths(){
 return portfolioProjects.filter(p=>p.slug!=='powerbi-internship').map(project=>({params:{slug:project.slug},props:{project}}));
}
---
<VisualProjectPage formal project={Astro.props.project.slug}/>
