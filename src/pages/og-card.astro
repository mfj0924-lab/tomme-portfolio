<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Tomme分享预览图</title>
  </head>
  <body>
    <main>
      <div class="copy">
        <p class="name">Tomme</p>
        <h1>我用数据理解问题，<br />也把判断做成<br />可以检查的作品。</h1>
        <p class="scope">经营分析 · 商业分析 · AI协作</p>
      </div>
      <div class="portrait">
        <div class="orbit orbit-blue"></div>
        <div class="orbit orbit-coral"></div>
        <img src="/assets/portrait-data-constructivist.png" alt="" />
        <span class="tag tag-a">从总览向下钻</span>
        <span class="tag tag-b">让结论可审查</span>
        <span class="tag tag-c">把城市连成网络</span>
      </div>
      <footer><span>作品与判断</span><span>mfj0924-lab</span></footer>
    </main>
  </body>
</html>

<style is:global>
  *{box-sizing:border-box}html,body{width:1200px;height:630px;margin:0;overflow:hidden}body{font-family:"Microsoft YaHei","Noto Sans SC",system-ui,sans-serif;color:#10192b;background:#f4f7fb}main{position:relative;width:1200px;height:630px;padding:64px 72px 52px;display:grid;grid-template-columns:1.2fr .8fr;gap:34px;background:radial-gradient(circle at 76% 24%,rgba(191,234,217,.72),transparent 26%),radial-gradient(circle at 42% 72%,rgba(223,231,255,.8),transparent 30%),#f4f7fb}.copy{position:relative;z-index:2}.name{margin:0 0 20px;color:#285cff;font-size:28px;font-weight:900}.copy h1{max-width:660px;margin:0;font-size:62px;line-height:1.08;letter-spacing:-.04em}.scope{margin:30px 0 0;font-size:22px;font-weight:700}.portrait{position:relative;min-width:0}.portrait img{position:absolute;right:36px;bottom:10px;z-index:2;width:350px;height:470px;object-fit:cover;object-position:50% 22%;border-radius:46% 46% 18px 18px}.orbit{position:absolute;border:2px solid;border-radius:50%}.orbit-blue{inset:30px -4px 12px -18px;border-color:rgba(40,92,255,.45);transform:rotate(-8deg)}.orbit-coral{inset:85px -16px 55px 28px;border-color:rgba(255,103,77,.5);transform:rotate(10deg)}.tag{position:absolute;z-index:3;padding:10px 14px;background:#fff;border:1px solid #c9d3e2;border-radius:8px;box-shadow:0 10px 24px rgba(16,25,43,.12);font-size:16px;font-weight:800}.tag-a{top:70px;left:-18px}.tag-b{top:180px;right:-8px}.tag-c{right:5px;bottom:25px}footer{position:absolute;left:72px;right:72px;bottom:24px;z-index:5;padding-top:14px;display:flex;justify-content:space-between;border-top:1px solid #c9d3e2;color:#556176;font-size:16px;font-weight:700}
</style>
