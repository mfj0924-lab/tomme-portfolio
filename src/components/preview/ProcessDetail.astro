---
import type {ProcessStep} from '../../data/preview-processes';
import MethodExplanation from './MethodExplanation.astro';
import methods from '../../data/project-methods.json';
const {step,project}=Astro.props;
const structured=Boolean(methods[project]?.[step.id]);
---
<div class="process-body">
 <p>{step.text}</p>
 <details class="process-details" data-process-step={step.id}>
  <summary><span class="process-toggle-sign" aria-hidden="true"></span><span class="process-open-label">查看处理方法与依据</span><span class="process-close-label">收起技术细节</span></summary>
  <div class="process-expanded">
   {structured?<MethodExplanation project={project} id={step.id}/>:step.paragraphs.map(text=><p>{text}</p>)}
   {!structured&&step.example&&<figure class="process-example"><figcaption>{step.example.label}</figcaption><pre>{step.example.text}</pre></figure>}
   <p class="process-output"><strong>这一步的结果：</strong>{step.output}</p>
   <p class="process-tools"><strong>使用工具与方法：</strong>{step.tools.join(' · ')}</p>
   <ul class="process-evidence" aria-label="这一步的代码与资料">
    {step.evidence.map(item=><li><a href={item.href} target="_blank" rel="noreferrer">{item.label}<span aria-hidden="true"> ↗</span></a></li>)}
   </ul>
  </div>
 </details>
</div>
