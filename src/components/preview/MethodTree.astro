---
import {methodology} from '../../data/lab-v3-copy';
---
<div class="section-title"><p>点击主题逐层展开，也可以直接阅读全文。</p><button id="expand-methods" class="text-button">展开全文</button></div>
<div class="method-tree">
     <aside class="method-root"><div class="method-emblem" aria-hidden="true"><svg viewBox="0 0 160 120"><path d="M20 60H64C90 60 74 24 108 24H140M64 60H140M64 60C90 60 74 96 108 96H140"/><circle cx="20" cy="60" r="9"/><circle cx="140" cy="24" r="6"/><circle cx="140" cy="60" r="6"/><circle cx="140" cy="96" r="6"/></svg></div><h2>方法论</h2><span>分析 · 协作 · 行动</span></aside>
     <div class="method-branches">{methodology.map((group,i)=><details class="method-branch"><summary><span class="branch-symbol">{['↗','✳','∿'][i]}</span><h2>{group.title}</h2><span class="expand-sign">＋</span></summary><div class="branch-body">{group.sections.map(section=><details class="method-section"><summary><h3>{section.title}</h3><span class="expand-sign">＋</span></summary><div class="original-copy">{section.paragraphs.map(p=><p>{p}</p>)}{'children' in section && section.children?.map(child=><details class="method-child"><summary><h4>{child.title}</h4><span class="expand-sign">＋</span></summary><div>{child.paragraphs.map(p=><p>{p}</p>)}</div></details>)}</div></details>)}</div></details>)}</div>
    </div>
